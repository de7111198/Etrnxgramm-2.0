import 'package:flutter/material.dart';

void main() {
  runApp(const EtrnxgramApp());
}

class EtrnxgramApp extends StatelessWidget {
  const EtrnxgramApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Etrnxgram',
      theme: ThemeData.dark().copyWith(
        scaffoldBackgroundColor: const Color(0xFF10111A),
        colorScheme: const ColorScheme.dark(
          primary: Color(0xFF9875FF),
          secondary: Color(0xFFB58AFF),
        ),
      ),
      home: const MainScreen(),
    );
  }
}

class MainScreen extends StatefulWidget {
  const MainScreen({super.key});

  @override
  State<MainScreen> createState() => _MainScreenState();
}

class _MainScreenState extends State<MainScreen> {
  int selected = 0;

  final pages = const [
    ChatsPage(),
    GiftsPage(),
    ContactsPage(),
    ProfilePage(),
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: const Color(0xFF171824),
        title: const Text(
          'Etrnxgram',
          style: TextStyle(
            color: Color(0xFFB99AFF),
            fontWeight: FontWeight.bold,
          ),
        ),
        actions: [
          IconButton(
            onPressed: () {},
            icon: const Icon(Icons.search),
          ),
        ],
      ),
      body: pages[selected],
      bottomNavigationBar: NavigationBar(
        backgroundColor: const Color(0xFF171824),
        selectedIndex: selected,
        onDestinationSelected: (index) {
          setState(() => selected = index);
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.chat_bubble_outline),
            label: 'Чаты',
          ),
          NavigationDestination(
            icon: Icon(Icons.card_giftcard),
            label: 'Подарки',
          ),
          NavigationDestination(
            icon: Icon(Icons.people_outline),
            label: 'Контакты',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            label: 'Профиль',
          ),
        ],
      ),
    );
  }
}

class ChatsPage extends StatelessWidget {
  const ChatsPage({super.key});

  @override
  Widget build(BuildContext context) {
    return const Center(
      child: Text(
        'Твои чаты появятся здесь',
        style: TextStyle(fontSize: 18),
      ),
    );
  }
}

class GiftsPage extends StatelessWidget {
  const GiftsPage({super.key});

  @override
  Widget build(BuildContext context) {
    return const Center(
      child: Text(
        'Подарки Etrnxgram',
        style: TextStyle(fontSize: 22),
      ),
    );
  }
}

class ContactsPage extends StatelessWidget {
  const ContactsPage({super.key});

  @override
  Widget build(BuildContext context) {
    return const Center(
      child: Text('Контакты', style: TextStyle(fontSize: 22)),
    );
  }
}

class ProfilePage extends StatelessWidget {
  const ProfilePage({super.key});

  @override
  Widget build(BuildContext context) {
    return const Center(
      child: Text(
        'Мой профиль',
        style: TextStyle(fontSize: 22),
      ),
    );
  }
}
